<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Ticket Confirmed</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f6f7f9;
        color: #1a1a1a;
      }
      .card {
        max-width: 640px;
        margin: 24px auto;
        background: #ffffff;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
      }
      h1 {
        margin: 0 0 16px;
        font-size: 22px;
      }
      .meta {
        margin: 0 0 12px;
      }
      .qr {
        margin-top: 20px;
        padding: 16px;
        border: 1px dashed #cccccc;
        border-radius: 8px;
        text-align: center;
        color: #555555;
      }
      .footer {
        margin-top: 24px;
        font-size: 12px;
        color: #666666;
      }
    </style>
  </head>
  <body>
    <div class='card'>
      <h1>Your ticket is confirmed</h1>
      <p class='meta'><strong>Workshop:</strong> {{workshop.title}}</p>
      <p class='meta'><strong>Time:</strong> {{workshop.startTime}}</p>
      <p class='meta'><strong>Location:</strong> {{workshop.location}}</p>

      <div class='qr'>
        <!-- Chỉ cần ghi src="cid:tên_cid_đã_đặt" -->
        <img
          src='cid:qrcode-image'
          alt='Ticket QR Code'
          width='150'
          height='150'
        />
        <br />
        <span style='font-size: 11px; color: #999;'>ID: {{qrCode}}</span>
      </div>

      <p class='footer'>Please show your QR code at check-in.</p>
    </div>
  </body>
</html>